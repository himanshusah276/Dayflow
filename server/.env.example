# Dayflow HRMS Server Configuration

# Server Port
PORT=5001

# Environment (development / production / test)
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET=dayflow_super_secret_jwt_key_2026_hrms_enterprise
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer SMTP Configuration)
# Leave blank to use console logger in local development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Dayflow HRMS" <no-reply@dayflow.com>

# Storage Configuration (local / s3)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
